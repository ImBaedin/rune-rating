{
	"name": "rune-rating",
	"private": true,
	"packageManager": "bun@1.3.9",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format": "biome format --write .",
		"lint": "turbo run lint && biome check .",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"build:web": "bun run --filter @rune-rating/web build",
		"build:netlify": "bun --cwd packages/backend convex deploy --cmd \"bun --cwd ../.. run --filter @rune-rating/web build\" --cmd-url-env-var-name VITE_CONVEX_URL"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"turbo": "^2.9.18",
		"typescript": "^5.9.3"
	}
}
